# Copy this file to .env and fill in your OpenRouter key only if you want cloud mode.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-3-4b-it:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Local is the default for development. Set to "OpenRouter (Cloud)" in hosted deployment secrets.
DEFAULT_PROVIDER=Local Gemma (Ollama)
AI_REQUEST_TIMEOUT=90
